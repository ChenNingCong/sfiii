   "source": [
    "import torch\n",
    "max_timestep = 512\n",
    "x = torch.randn(size=(100000,))\n",
    "# map [-inf, inf] to [0, 1]\n",
    "x = torch.sigmoid(x)\n",
    "# scale the timestep into [0, max_timestep]\n",
    "timestep = x * max_timestep"
   ]
